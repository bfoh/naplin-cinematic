{
  "name": "naplin-cinematic",
  "version": "0.1.0",
  "private": true,
  "description": "Hair By Naplin — Cinematic Edition. Standalone Next.js brand experience.",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "media": "node scripts/build-media.mjs",
    "test": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "~5.9.3"
  }
}
